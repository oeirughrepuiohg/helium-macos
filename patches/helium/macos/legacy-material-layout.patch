+  // Legacy Material Design tab shape from Chromium v68.
+  // Uses cubic Bezier S-curves on each side to create the characteristic
+  // trapezoidal "wing" shape where tabs smoothly transition into the toolbar.
+  //
+  //         ╭──────────────────────╮
+  //        ╱   Tab Title            ╲
+  // ──────╱                          ╲──────
+  //
+  // Width of the S-curve endcap on each side of the tab, in DIP.
+  // Equals GetLayoutInsets(TAB).left() - 0.5 = 16 - 0.5 = 15.5 DIP in v68.
+  constexpr float kEndcapWidthDip = 15.5f;
+  const float s = scale;
+  const float e = kEndcapWidthDip * s;
+
+  const gfx::RectF aligned_bounds =
+      ScaleAndAlignBounds(tab()->bounds(), scale, stroke_thickness);
+
+  const float left = aligned_bounds.x();
+  const float right = aligned_bounds.right();
+  // In v68, the top of the path was offset by (scale - 1) device pixels to
+  // align with the 1-device-pixel stroke along the tab's top edge.
+  const float top = aligned_bounds.y() + (s - 1.0f);
+  const float bottom = aligned_bounds.bottom();
+
+  // Clamp the endcap so it cannot exceed half the tab width, preventing the
+  // left and right S-curves from crossing on very narrow tabs.
+  const float half_width = (right - left) / 2.0f;
+  const float clamped_e = std::min(e, half_width);
+
+  BrowserFrameView* const browser_frame_view = GetBrowserFrameView();
+  const bool is_frame_condensed =
+      browser_frame_view ? browser_frame_view->IsFrameCondensed() : false;
+
+  SkPathBuilder path;
+  path.incReserve(20);
+
+  if (path_type == TabStyle::PathType::kHitTest && is_frame_condensed) {
+    // In maximized/fullscreen mode, square off the top of the hit-test path to
+    // the screen edge, eliminating any gap between adjacent tabs at the top.
+    path.moveTo(left, bottom);
+    path.lineTo(left, aligned_bounds.y());
+    path.lineTo(right, aligned_bounds.y());
+    path.lineTo(right, bottom);
+    path.close();
+  } else {
+    // Standard legacy S-curve path, drawn clockwise from the bottom-left.
+    path.moveTo(left, bottom);
+    // Drop 1 device pixel below the toolbar baseline (intentionally not scaled
+    // by `s` since it represents 1 absolute device pixel, creating a sharp
+    // anti-aliased edge between tab and toolbar at any scale factor).
+    path.lineTo(left, bottom - 1.0f);
+    // Bottom-left S-curve: from horizontal baseline upward.
+    path.cubicTo(left + 0.75f * s,                         bottom - 1.0f,
+                 left + 1.625f * s,                        bottom - 1.0f - 0.5f * s,
+                 left + 2.0f * s,                          bottom - 1.0f - 1.5f * s);
+    // Left diagonal rising toward the top-left curve.
+    path.lineTo(left + (kEndcapWidthDip - 2.0f) * s,      top + 1.5f * s);
+    // Top-left S-curve: from diagonal to horizontal tab-top.
+    path.cubicTo(left + (kEndcapWidthDip - 1.625f) * s,   top + 0.5f * s,
+                 left + (kEndcapWidthDip - 0.75f) * s,    top,
+                 left + clamped_e,                         top);
+    // Horizontal top edge.
+    path.lineTo(right - clamped_e,                         top);
+    // Top-right S-curve (mirror of top-left).
+    path.cubicTo(right - (kEndcapWidthDip - 0.75f) * s,   top,
+                 right - (kEndcapWidthDip - 1.625f) * s,  top + 0.5f * s,
+                 right - (kEndcapWidthDip - 2.0f) * s,    top + 1.5f * s);
+    // Right diagonal descending toward the bottom-right curve.
+    path.lineTo(right - 2.0f * s,                          bottom - 1.0f - 1.5f * s);
+    // Bottom-right S-curve (mirror of bottom-left).
+    path.cubicTo(right - 1.625f * s,                       bottom - 1.0f - 0.5f * s,
+                 right - 0.75f * s,                        bottom - 1.0f,
+                 right,                                    bottom - 1.0f);
+    // Rise 1 device pixel back to the toolbar baseline, mirroring the drop at
+    // the bottom-left. The closed shape spans from bottom (baseline) on both
+    // sides, with the 1px drop/rise creating a sharp crisp edge.
+    path.lineTo(right, bottom);
+
+    if (path_type != TabStyle::PathType::kBorder) {
+      path.close();
+    }
+  }
+
+  // Convert path to be relative to the tab origin.
+  gfx::PointF origin(tab_->origin());
+  origin.Scale(scale);
+  path.offset(-origin.x(), -origin.y());
+
+  // Possibly convert back to DIPs.
+  if (flags.render_units == TabStyle::RenderUnits::kDips && scale != 1.0f) {
+    path.transform(SkMatrix::Scale(1.0f / scale, 1.0f / scale));
+  }
+
+  return path.detach();
